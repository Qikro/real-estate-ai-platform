# Real Estate AI Operations Platform - Environment Configuration
APP_NAME="Real Estate AI Operations Platform"
APP_VERSION="1.0.0"

# Security & JWT Tokens
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default: SQLite WAL mode; For Production: PostgreSQL)
DATABASE_URL="sqlite:///./data/estate_ops.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/estate_ops"

# Target Regional Market
INITIAL_TARGET_CITY="Hyderabad"
INITIAL_TARGET_STATE="Telangana"
INITIAL_TARGET_COUNTRY="India"
DEFAULT_CURRENCY="INR"
SECONDARY_CURRENCY="USD"

# Storage Directories
DATA_DIR="./data"
REPORTS_DIR="./data/reports"

# External Integrations (Optional / Fill when authorized)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_CALENDAR_CREDENTIALS=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
